#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────────────────────
# SlozOS Pro branding. Makes the system say SlozOS Pro, never Zorin OS.
#
# Run by the slozos-pro-desktop package on install, and again (dpkg file
# triggers, see DEBIAN/triggers) whenever an update to Zorin OS or Ubuntu
# packages puts Zorin names back: os-release, app menu entries, extension
# names, wallpapers, session names. Idempotent.
# ──────────────────────────────────────────────────────────────────────────────
set -u
VERSION=$(cat /usr/share/slozos-pro/version 2>/dev/null || echo 1.0)
GH=https://github.com/JackachuYT/SlozOS-Pro

# ── os-release / lsb-release ─────────────────────────────────────────────────
# ID stays "zorin" and VERSION_ID stays "18": Zorin's and Ubuntu's own update
# tools key off those. Everything people see says SlozOS Pro.
if [[ -f /usr/lib/os-release ]]; then
    sed -i \
        -e "s|^PRETTY_NAME=.*|PRETTY_NAME=\"SlozOS Pro $VERSION\"|" \
        -e "s|^NAME=.*|NAME=\"SlozOS Pro\"|" \
        -e "s|^VERSION=.*|VERSION=\"$VERSION\"|" \
        -e "s|^HOME_URL=.*|HOME_URL=\"$GH\"|" \
        -e "s|^SUPPORT_URL=.*|SUPPORT_URL=\"$GH#readme\"|" \
        -e "s|^BUG_REPORT_URL=.*|BUG_REPORT_URL=\"$GH/issues\"|" \
        -e "/^PRIVACY_POLICY_URL=/d" \
        -e "s|^LOGO=.*|LOGO=slozos-pro-logo|" \
        -e "/^SLOZOS_PRO_VERSION=/d" \
        /usr/lib/os-release
    echo "SLOZOS_PRO_VERSION=\"$VERSION\"" >> /usr/lib/os-release
fi
if [[ -f /etc/lsb-release ]]; then
    sed -i "s|^DISTRIB_DESCRIPTION=.*|DISTRIB_DESCRIPTION=\"SlozOS Pro $VERSION\"|" /etc/lsb-release
fi
[[ -f /etc/issue ]] && printf 'SlozOS Pro %s \\n \\l\n\n' "$VERSION" > /etc/issue
[[ -f /etc/issue.net ]] && echo "SlozOS Pro $VERSION" > /etc/issue.net

# ── App menu ─────────────────────────────────────────────────────────────────
# Entries in /usr/local/share/applications take precedence over the package
# ones in /usr/share/applications, and package updates never touch them.
LOCAL=/usr/local/share/applications
MARK="# slozos-pro: generated by /usr/lib/slozos-pro/brand"
mkdir -p "$LOCAL"
rename_entry() {  # rename_entry FILE: Zorin names → SlozOS names, as an override
    local src=$1 dst="$LOCAL/$(basename "$1")"
    { echo "$MARK"; sed -E \
        -e '/^(Name|GenericName|Comment|X-GNOME-FullName|Keywords)(\[[^]]*\])?=/ {
              s/Zorin Connect/Phone Connect/g
              s/Zorin OS/SlozOS Pro/g
              s/Zorin/SlozOS/g
            }' "$src"; } > "$dst"
}
hide_entry() {    # hide_entry FILE: keep it installed, out of the app menu
    local src=$1 dst="$LOCAL/$(basename "$1")"
    { echo "$MARK"; sed '/^NoDisplay=/d' "$src" | sed '/^\[Desktop Entry\]/a NoDisplay=true'; } > "$dst"
}
for f in /usr/share/applications/*.desktop; do
    [[ -f $f ]] || continue
    case "$(basename "$f")" in
        # Zorin's layout/theme switcher, auto theme and "Upgrade Zorin OS"
        # (which would move you onto the next Zorin OS, not SlozOS Pro), and
        # Zorin's welcome tour
        zorin-appearance.desktop|com.zorin.desktop.auto-theme.desktop|com.zorin.desktop.upgrader.desktop|org.gnome.Tour.desktop)
            hide_entry "$f" ;;
        *)
            grep -qiE '^(Name|GenericName|Comment|X-GNOME-FullName)(\[[^]]*\])?=.*zorin' "$f" && rename_entry "$f" ;;
    esac
done
# drop overrides whose package entry is gone
for f in "$LOCAL"/*.desktop; do
    [[ -f $f && ! -f /usr/share/applications/$(basename "$f") ]] && head -1 "$f" | grep -qxF "$MARK" && rm -f "$f"
done

# Zorin's welcome tour opens at first login; SlozOS Pro has its own welcome
for f in /etc/xdg/autostart/*.desktop; do
    [[ -f $f ]] || continue
    if grep -qiE '^Exec=.*(gnome-tour|zorin-os-tour|zorin-gnome-tour)' "$f"; then
        grep -q '^Hidden=true' "$f" || sed -i '/^\[Desktop Entry\]/a Hidden=true' "$f"
    fi
done

# ── Login session names ──────────────────────────────────────────────────────
for f in /usr/share/wayland-sessions/*.desktop /usr/share/xsessions/*.desktop; do
    [[ -f $f ]] || continue
    sed -i -E '/^(Name|Comment)(\[[^]]*\])?=/ { s/Zorin OS/SlozOS Pro/g; s/Zorin/SlozOS Pro/g }' "$f"
done

# ── Shell extension names (Extensions app) ───────────────────────────────────
for m in /usr/share/gnome-shell/extensions/*zorinos.com/metadata.json; do
    [[ -f $m ]] || continue
    sed -i -E 's/"name": *"Zorin Connect"/"name": "Phone Connect"/; s/"name": *"Zorin ([^"]*)"/"name": "\1"/' "$m"
done

# ── Wallpapers: SlozOS Pro's, plus Zorin's photo collection minus its logos ──
for f in /usr/share/backgrounds/Zorin*; do
    [[ -e $f ]] && rm -f "$f"
done
for x in /usr/share/gnome-background-properties/*.xml; do
    [[ -f $x ]] || continue
    grep -q '/backgrounds/Zorin' "$x" || continue
    python3 - "$x" <<'EOF'
import re, sys
path = sys.argv[1]
text = open(path).read()
text = re.sub(r'\s*<wallpaper[^>]*>(?:(?!</wallpaper>).)*?/backgrounds/Zorin(?:(?!</wallpaper>).)*?</wallpaper>', '', text, flags=re.S)
open(path, "w").write(text)
EOF
done

# ── Privacy: Zorin's anonymous install census ────────────────────────────────
for u in $(systemctl list-unit-files --no-legend 2>/dev/null | awk '/census/ {print $1}'); do
    systemctl mask "$u" >/dev/null 2>&1
done
exit 0
